{
  "name": "Indicator Paper QA — Linux Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/run-linux-qa.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [],
  "remoteEnv": {
    "ALERTS_ENABLED": "false",
    "PAPER_AUTOTRADE_ENABLED": "false",
    "PAPER_DASHBOARD_ENABLED": "false",
    "KITE_SHADOW_ENABLED": "false",
    "PAPER_PREMIUM_TRACKING_ENABLED": "false"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}

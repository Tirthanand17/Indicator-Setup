{
  "name": "nifty-paper-offline-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test *.test.mjs",
    "test:runtime": "node --test runtime/*.test.mjs",
    "preflight:offline": "node offline-preflight.mjs",
    "bench:offline": "node runtime/offline-capacity-benchmark.mjs",
    "metrics:probe": "node cloudflare-metrics-cli.mjs",
    "quality:js": "node ../scripts/offline-quality.mjs --js && npm audit --audit-level=low",
    "quality:all": "node ../scripts/offline-quality.mjs --all && npm audit --audit-level=low"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "miniflare": "4.20260730.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5"
  }
}

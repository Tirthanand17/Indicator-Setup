# CLOUD SERVER CONFIGURATION — place in provider's encrypted secrets interface, NOT GitHub.
ALERTS_ENABLED=false
# Optional untrusted KiteTicker shadow diagnostics, does NOT power trade alerts.
KITE_SHADOW_ENABLED=false
# Opt-in, unvalidated hypothetical option premium exit reviews, NO actual holding
PAPER_PREMIUM_TRACKING_ENABLED=false
# Phase 41: private paper dashboard, always OFF until a tested approved host exists.
PAPER_DASHBOARD_ENABLED=false
# Phase 41: autonomous simulated fills, OFF until full integration acceptance.
PAPER_AUTOTRADE_ENABLED=false
# REQUIRED if dashboard is enabled. Generate a unique strong random key; never commit it.
PAPER_DASHBOARD_KEY=REPLACE_WITH_RANDOM_PRIVATE_DASHBOARD_ACCESS_KEY
KITE_API_KEY=REPLACE_WITH_YOUR_KITE_API_KEY
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_PRIVATE_CHAT_ID
TOKEN_RELAY_HMAC_KEY=REPLACE_WITH_RANDOM_64_OR_MORE_HEX_CHARACTERS
TOKEN_VAULT_KEY=REPLACE_WITH_FERNET_KEY
STATE_DIR=/data/nifty-alerts

# LOCAL NIRALA RELAY (machine environment, outside protected trading folder)
# KITE_ALERT_TOKEN_ENDPOINT=https://YOUR-ALWAYS-ON-HOST/internal/token
# TOKEN_RELAY_HMAC_KEY=same_key_as_cloud
# KITE_API_KEY=same_api_key_as_cloud
# Existing read-only .env in protected folder supplies ZERODHA_KITE_ACCESS_TOKEN.

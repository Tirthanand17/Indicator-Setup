{
  "manifest_version": 3,
  "name": "NIFTY Five-Indicator Paper Alerts",
  "version": "0.3.0",
  "description": "Reads NIFTY futures chart indicators and offers opt-in Telegram phone alerts for paper CE/PE reviews. Never places orders.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://kite.zerodha.com/*"
  ],
  "action": {
    "default_title": "NIFTY Paper Alerts",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kite.zerodha.com/*"
      ],
      "js": [
        "reader.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "optional_host_permissions": [
    "https://api.telegram.org/*"
  ]
}
